{
  "name": "the-man-store",
  "version": "1.0.0",
  "private": true,
  "description": "The Man Store Management System",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:all": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "cd backend && php artisan serve --port=8003",
    "dev:admin": "npm --prefix frontend run dev",
    "dev:storefront": "npm --prefix frontend run dev",
    "dev:mobile": "cd mobile && flutter run",
    "setup": "node ./scripts/setup.cjs",
    "install:all": "npm install && npm --prefix frontend install && cd backend && composer install",
    "clean:ports": "lsof -ti:5173,8003 | xargs kill -9 2>/dev/null || true",
    "db:migrate": "cd backend && php artisan migrate",
    "db:seed": "cd backend && php artisan db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
