# Copy to `.env` or `.env.local` (gitignored). Never commit real secrets.

NODE_ENV=development

# --- API (must match where Laravel actually runs) ---
# Repo `docker-compose.yml`: backend is http://127.0.0.1:8001 (not 8000).
#
# Recommended for `npm run dev`: same-origin `/api` + Vite proxy (avoids CORS; see vite.config.js).
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://127.0.0.1:8001
#
# Optional: used when VITE_API_BASE_URL is NOT a path (e.g. direct calls to Laravel).
VITE_BACKEND_ORIGIN=http://127.0.0.1:8001
#
# Alternative — call Laravel directly (no proxy): uncomment and drop VITE_API_BASE_URL=/api above.
# VITE_BACKEND_ORIGIN=http://127.0.0.1:8001
# VITE_API_BASE_URL=http://127.0.0.1:8001/api

# Send cookies to the API (needed for Sanctum/session on another origin).
VITE_WITH_CREDENTIALS=true

# Optional: only when the API returns /storage/... paths (legacy local disk).
# Leave UNSET when the API returns full R2 URLs (https://media.themanstore.online/...).
# Do NOT set to Cloudinary or R2 CDN base — that breaks paths (404).
# VITE_STORAGE_MEDIA_ORIGIN=https://fitandsleek-official-backend.onrender.com

# Cloudflare Turnstile (site key only; secret stays on the backend).
# VITE_TURNSTILE_SITE_KEY=

# Dev: comma-separated Host headers allowed by Vite (e.g. LAN IP or machine name).
# VITE_EXTRA_ALLOWED_HOSTS=192.168.1.10,my-pc

# Dev: set to 1 to restrict Vite to defaultAllowedHosts + VITE_EXTRA_ALLOWED_HOSTS (otherwise any Host is allowed).
# VITE_STRICT_DEV_HOSTS=1

# --- Production (Render static site — www.themanstore.online) ---
# Set these as Environment Variables on the Render *frontend* service, then redeploy (rebuild):
#   VITE_BACKEND_ORIGIN=https://fitandsleek-official-backend.onrender.com
#   VITE_API_BASE_URL=https://fitandsleek-official-backend.onrender.com/api
#   VITE_STORAGE_MEDIA_ORIGIN=          (leave empty — R2 URLs come from the API)
# www.themanstore.online → backend mapping is also in src/lib/backendOrigin.js
# Google OAuth (automatic per storefront host via src/lib/backendOrigin.js):
#   localhost:5173        → http://localhost:8001/api/auth/google/callback
#   fitandsleek.kalapak-team.space → https://fitandsleekapp.kalapak-team.space/api/auth/google/callback
#   web-fitandsleek.onrender.com   → https://api-fitandsleek.onrender.com/api/auth/google/callback
# Register all of those callback URLs in Google Cloud Console.
# Or set explicitly at build time:
# VITE_API_BASE_URL=https://api-fitandsleek.onrender.com/api
