{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(favicon\\.ico|favicon\\.svg|favicon\\.png|favicon-48\\.png|favicon-96\\.png|favicon-192\\.png|apple-touch-icon\\.png|logo\\.png|logo-circle\\.png|logo\\.svg|logo-circle\\.svg|placeholder\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.ico|favicon\\.svg|favicon\\.png|favicon-48\\.png|favicon-96\\.png|favicon-192\\.png|apple-touch-icon\\.png|logo\\.png|logo-circle\\.png|logo\\.svg|logo-circle\\.svg|placeholder\\.svg|google[a-f0-9]+\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
