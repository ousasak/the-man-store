              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "mobile", "init"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
