APP_NAME="The Man Store"
APP_ENV=local
APP_KEY=base64:WB7exd+Pwqyoc6EhOhCt26cMFbuEz3oQG46UKDn0pms=
APP_DEBUG=true
# Local PHP: 8000. Docker compose maps backend to host port 8001 — use APP_URL there accordingly.
APP_URL=http://127.0.0.1:8001
APP_PORT=8000
SERVER_PORT=8000

# Security & API Keys
# DO NOT share these values publicly
GOOGLE_VISION_API_KEY=

# Chat AI — trained Hugging Face Space (Admin Ask AI + storefront chatbot)
# https://huggingface.co/spaces/Kalapak/fitandsleekAIchat
CHATBOT_PROVIDER=huggingface
CHATBOT_HF_URL=https://kalapak-fitandsleekaichat.hf.space
CHATBOT_HF_TOKEN=
CHATBOT_HF_PROTOCOL=call
CHATBOT_HF_FN_INDEX=7
CHATBOT_HF_SEND_HISTORY=true
CHATBOT_HF_TIMEOUT=120
CHATBOT_HF_HISTORY_TURNS=6
HF_CHAT_SPACE_ID=Kalapak/fitandsleekAIchat
# Legacy fallbacks (optional if CHATBOT_* is set)
# HF_CHAT_BASE_URL=https://kalapak-fitandsleekaichat.hf.space
# HF_CHAT_TIMEOUT=120
# HF_TOKEN=hf_xxxxxxxx

# Rielpay KHQR gateway (Bakong/NBC handled by Rielpay — no direct NBC API from Render)
RIELPAY_API_URL=https://api-norng-rielpay.fitandsleek.online
RIELPAY_API_KEY=your_rielpay_api_key_here
RIELPAY_CURRENCY=KHR
RIELPAY_EXPIRES_IN=300
# Shop paper invoices print a static Bakong KHQR that does not expire until the order is paid.
# RIELPAY_EXPIRES_IN still applies only to checkout / Telegram dynamic QRs.

# Mobile tap-to-pay metadata (Rielpay calls NBC generate_deeplink_by_qr on your behalf)
RIELPAY_DEEPLINK_APP_NAME="The Man Store"
RIELPAY_DEEPLINK_ICON_URL=https://www.fitandsleek.online/logo-circle.png
RIELPAY_DEEPLINK_CALLBACK=themanstore://payment/callback

# Optional — confirm paid KHQR scans with NBC when Rielpay still says pending/expired.
# Cambodia host: cd backend/bakong-proxy && ./start-php-proxy.sh
# BAKONG_PROXY_URL=http://host.docker.internal:8787/index.php
# BAKONG_PROXY_SECRET=
# BAKONG_TOKEN=

# ABA PayWay
ABA_PAYWAY_MERCHANT_ID=304810
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_API_SECRET=
ABA_PAYWAY_RETURN_URL=
ABA_PAYWAY_CALLBACK_URL=
ABA_PAYWAY_PAYMENT_LINK=https://link.payway.com.kh/ABAPAYzf414921x

# Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fallback redirect URIs (OAuth uses the API host from the incoming request when it is allowed).
# Register EVERY callback below in Google Cloud Console → Authorized redirect URIs:
#   http://localhost:8001/api/auth/google/callback
#   http://127.0.0.1:8001/api/auth/google/callback
#   https://fitandsleekapp.kalapak-team.space/api/auth/google/callback
#   https://api-fitandsleek.onrender.com/api/auth/google/callback
#   https://fitandsleek-official-backend.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://fitandsleek-official-backend.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI_LOCAL=http://localhost:8001/api/auth/google/callback
# Comma-separated extra API origins (scheme://host[:port]) if you add more deploy targets
# OAUTH_EXTRA_API_ORIGINS=
# OAUTH_TRUST_ONRENDER_API_HOSTS=true
APP_URL_LOCAL=http://localhost:8001
FRONTEND_URL_LOCAL=http://localhost:5173

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://fitandsleek-official-backend.onrender.com/api/auth/facebook/callback
FACEBOOK_REDIRECT_URI_LOCAL=http://localhost:8001/api/auth/facebook/callback

# Database
# --- Local Docker (repo `docker-compose.yml`) ---
# From Windows/Mac HOST use port 5433 (mapped 5433→5432). Inside the PHP container use DB_HOST=db and DB_PORT=5432.
# Native Postgres on machine: usually DB_HOST=127.0.0.1 DB_PORT=5432
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=the_man_store_db
DB_USERNAME=postgres
DB_PASSWORD=Norng@123

# --- Neon PostgreSQL (production on Render) ---
# Copy the connection string from Neon Dashboard → Connection details.
# When DATABASE_URL is set, Laravel uses it for the pgsql connection (overrides DB_HOST/PORT/NAME/USER/PASSWORD).
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_SSLMODE=require
# Migrate local pgAdmin backup → Neon: pgAdmin Restore, or `pg_restore -d "$DATABASE_URL" backup.dump`

# Services
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=themanstore_bot
# BotFather mini app → your bot → Login Widget → Allowed URLs:
#   https://fitandsleek.kalapak-team.space
#   https://fitandsleek.online
#   https://www.fitandsleek.online
# Client ID shown there (defaults to the bot id if unset)
# TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://fitandsleekapp.kalapak-team.space
# Official “Log in with Telegram” widget: in @BotFather send /setdomain
# then the shop hostname only (no https://), e.g. fitandsleek.kalapak-team.space
TELEGRAM_ADMIN_CHAT_ID=
# Private/public Telegram URL used by the post-link "Open seller group" button.
TELEGRAM_ADMIN_GROUP_INVITE_URL=
# Local Docker sets APP_URL=http://localhost — use TELEGRAM_WEBHOOK_URL for artisan telegram:set-webhook
# After deploy, run: php artisan telegram:set-webhook (must include callback_query for Invoice / Payment QR buttons)
TELEGRAM_BROADCAST_MESSAGES_PER_SECOND=25
TELEGRAM_BROADCAST_CHUNK_SIZE=100
TELEGRAM_BROADCAST_RETRY_ATTEMPTS=3
TELEGRAM_BROADCAST_ESTIMATED_WORKERS=1
TELEGRAM_BROADCAST_RETENTION_DAYS=30

# --- Database backup (pg_dump → encrypt → Telegram + optional R2) ---
# Generate key: openssl rand -base64 32
# Group chat id: send /chatid in the backup group after deploy
BACKUP_ENABLED=true
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_SCHEDULE_AT=02:00
BACKUP_TIMEZONE=Asia/Phnom_Penh
BACKUP_DISK=backup
BACKUP_PATH_PREFIX=database-backups
# Skip scheduled backup when DB change counters match the last successful dump
BACKUP_SKIP_IF_UNCHANGED=true
# Set true to also Telegram-notify when a nightly run is skipped
BACKUP_NOTIFY_SKIP=false
# Optional dedicated R2 bucket (falls back to R2_* / AWS_* when unset):
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_R2_BUCKET=fitandsleek-backups
# BACKUP_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# BACKUP_R2_REGION=auto
# Manual run: php artisan backup:database
# Force even if unchanged: php artisan backup:database --force
# Or from Telegram backup/admin group: /backup (always forced)

# When true, OTP codes are logged server-side only (never returned to the browser).
OTP_DEBUG=false
OTP_EXPIRES_MINUTES=10

# Infrastructure
LOG_CHANNEL=stack
LOG_LEVEL=debug
BROADCAST_CONNECTION=log

# Media storage
# Local dev without cloud: FILESYSTEM_DISK=public
# Production (Fitandsleek): Cloudflare R2 bucket "fitandsleek"
# Cloudinary (alternative): FILESYSTEM_DISK=cloudinary
FILESYSTEM_DISK=public
# When true, failed cloud uploads fall back to local public disk (dev only).
MEDIA_FALLBACK_TO_PUBLIC=true
# Admin profile image upload target disk (defaults to FILESYSTEM_DISK when unset):
ADMIN_PROFILE_IMAGE_DISK=public
# In production, prefer false so uploads never silently fall back to local Render storage.
ADMIN_PROFILE_IMAGE_FALLBACK_TO_PUBLIC=false

# --- Cloudinary (recommended production storage) ---
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: used when your Cloudinary account requires/uses unsigned upload preset.
CLOUDINARY_UPLOAD_PRESET=

# --- Cloudflare R2 (production: FILESYSTEM_DISK=r2) ---
# Account ID (S3 endpoint host): 29531ec21763c961814bc2de1cf2aa75
# Dashboard: R2 → Create bucket "fitandsleek" → API token → public domain or r2.dev URL.
# Custom domain media.fitandsleek.online requires fitandsleek.online zone on the SAME Cloudflare account.
# CORS on the bucket must allow www.fitandsleek.online + fitandsleek-official-backend.onrender.com.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=fitandsleek
# R2_ENDPOINT=https://29531ec21763c961814bc2de1cf2aa75.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://media.fitandsleek.online
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# R2_REGION=auto
# R2_USE_PATH_STYLE_ENDPOINT=true
# Optional aliases (same values; used if R2_* vars are unset):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_DEFAULT_REGION=auto
# AWS_USE_PATH_STYLE_ENDPOINT=true
QUEUE_CONNECTION=database
# Render Free (recommended): keep boot light — set in dashboard or render.yaml
# RUN_MIGRATIONS=false
# RUN_QUEUE_WORKER=false
# RUN_SCHEDULER=false
# Image scan-to-search — own Fitandsleek Vector Space (Qdrant-compatible)
# https://huggingface.co/spaces/Kalapak/fitandsleek-vector
# 1) Open Space → register/login → copy api-key (fsv_…)
# 2) Set FITANDSLEEK_VECTOR_API_KEY (or QDRANT_API_KEY) below
# 3) php artisan qdrant:setup && php artisan qdrant:index-products
FITANDSLEEK_VECTOR_URL=https://kalapak-fitandsleek-vector.hf.space
FITANDSLEEK_VECTOR_API_KEY=
# Optional overrides (defaults derive from FITANDSLEEK_VECTOR_URL):
# FITANDSLEEK_CLIP_ENDPOINT=https://kalapak-fitandsleek-vector.hf.space/embed/image
# QDRANT_URL_OVERRIDE=https://kalapak-fitandsleek-vector.hf.space
# Legacy QDRANT_URL is ignored when FITANDSLEEK_VECTOR_URL is set.
QDRANT_API_KEY=
QDRANT_COLLECTION=products_fitandsleek_512
QDRANT_VECTOR_SIZE=512
FITANDSLEEK_CLIP_VECTOR_SIZE=512
IMAGE_SEARCH_TIMEOUT=90
VECTOR_PROVIDER=fitandsleek_vector
# QDRANT_SETUP_ON_BOOT=false
# QDRANT_INDEX_MISSING_ON_BOOT=false
# php artisan qdrant:setup && php artisan qdrant:index-products
# php artisan qdrant:index-products --only-missing
# php artisan qdrant:diagnose

# Session & Cache
CACHE_STORE=file
SESSION_DRIVER=file
REDIS_ENABLED=false
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=127.0.0.1
REDIS_CLIENT=predis
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production Redis example (Upstash/Render): set these in deployment env vars.
# REDIS_CLIENT=predis
# REDIS_SCHEME=tls
# REDIS_HOST=your-upstash-host.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_upstash_password
# REDIS_ENABLED=true
# CACHE_STORE=redis
# SESSION_DRIVER=redis

# Mail — Resend (recommended for production OTP / transactional email)
MAIL_MAILER=resend
RESEND_API_KEY=re_xxxxxxxx
# Test sender (Resend sandbox — can only deliver to your verified inbox)
MAIL_FROM_ADDRESS=onboarding@resend.dev
# Production: verify fitandsleek.online in Resend, then use e.g. no-reply@fitandsleek.online
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=
# Local SMTP alternative (Mailtrap / Gmail)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_smtp_username
# MAIL_PASSWORD=your_smtp_password
# MAIL_ENCRYPTION=tls

# Mobile OAuth deep link (Flutter — must match AppConfig.oauthCallbackUrl)
MOBILE_OAUTH_CALLBACK_URL=themanstore://oauth/callback

# Frontend Integration
FRONTEND_URL=http://127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:5173,localhost:5173,0.0.0.0:5173
VITE_APP_NAME="${APP_NAME}"